# Streamlit에서 호출할 FastAPI 주소
K_GLOBAL_API_URL=http://127.0.0.1:8000/api/v1
K_GLOBAL_API_TIMEOUT=2.0
K_GLOBAL_API_FALLBACK=true

# 출처 기반 AI 초기 검토안 생성
# 키가 없거나 비활성화되면 규칙 기반 검토안을 반환합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REPORTS_ENABLED=true
OPENAI_API_TIMEOUT=45

# 외교부 LOD SPARQL 수집 설정
MOFA_SPARQL_TIMEOUT=20
MOFA_COLLECTION_LIMIT=100

# 공공데이터포털 인증키
# DATA_GO_KR_SERVICE_KEY 하나로 KF·MOFA·KOICA API를 호출할 수 있습니다.
# KOICA 전용 키를 따로 관리할 경우 KOICA_SERVICE_KEY에도 같은 일반 인증키를 입력합니다.
DATA_GO_KR_SERVICE_KEY=
KOICA_SERVICE_KEY=

# 데이터·알고리즘 실제 데이터베이스 경로
RADAR_DB_PATH=data_algorithm/data/radar_real.db
